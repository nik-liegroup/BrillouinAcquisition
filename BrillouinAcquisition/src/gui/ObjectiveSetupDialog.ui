    <widget class="QLabel" name="instructionsLabel">
     <property name="text">
      <string>Name each nosepiece slot as its magnification followed by "x" (e.g. 5x, 10x, 20x, 63x) - one or two digits, 1-99. Leave a slot blank if it is unused or unnamed. Optionally link a saved scale-calibration file (.h5) to a slot - it loads automatically at startup and re-applies every time the nosepiece switches to that slot.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
